{
  "name": "pc-speaker",
  "version": "1.0.0",
  "description": "Windows desktop host for PC Speaker",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.pcspeaker.app",
    "productName": "PC Speaker",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  }
}
